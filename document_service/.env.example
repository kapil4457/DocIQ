# Document Service Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dociq

# Database Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Worker Settings
WORKER_POLL_INTERVAL=30
WORKER_BATCH_SIZE=10

# Security
MAX_FILE_SIZE=52428800
MAX_PROCESSING_SIZE=52428800

# ClamAV
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=120
# Host path of the Docker volume shared with the ClamAV container (scan staging dir)
SECURITY_SCAN_DIR=/var/lib/dociq/scan
# Path of that volume inside the container (empty string = no path translation)
CLAMAV_SHARED_MOUNT_CONTAINER=/shared

# R2 Object Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Logging
LOG_LEVEL=INFO